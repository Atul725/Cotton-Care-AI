# ==============================================================================
# CottonCare AI - Environment Configuration Example
# Copy this file to .env and insert your real credentials.
# ==============================================================================

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (supports gemini-3.8-flash, gemini-3.6-flash, gemini-3.5-flash)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash

# SQLite Database Location
DATABASE_URL=sqlite:///data/cottoncare.db

# Flask / Secret Key for session signing
FLASK_SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
